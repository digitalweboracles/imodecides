Options -Indexes
DirectoryIndex index.php
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteRule ^(data|includes|legacy|tools)(/|$) - [F,L]
RewriteRule ^(config\.php|Dockerfile|docker-entrypoint\.sh|README\.md)$ - [F,L]
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]
RewriteRule ^home/?$ questions.php?feed=home [L,QSA]
RewriteRule ^questions/?$ questions.php [L,QSA]
RewriteRule ^log-in/?$ account.php?a=login [L,QSA]
RewriteRule ^signup/?$ account.php?a=signup [L,QSA]
RewriteRule ^lost-password/?$ account.php?a=lost [L,QSA]
RewriteRule ^reset-password/?$ account.php?a=reset [L,QSA]
RewriteRule ^logout/?$ account.php?a=logout [L,QSA]
RewriteRule ^add-question/?$ ask.php [L,QSA]
RewriteRule ^profile/([^/]+)/?$ profile.php?u=$1 [L,QSA]
RewriteRule ^(terms|privacy-policy)/?$ page.php?p=$1 [L,QSA]
RewriteRule ^question/([A-Za-z0-9-]+)/?$ poll.php?slug=$1 [L,QSA]
RewriteRule ^search/?$ search.php [L,QSA]
RewriteRule ^([a-z0-9-]+)/?$ position.php?slug=$1 [L,QSA]
</IfModule>
<IfModule mod_headers.c>
Header set X-Content-Type-Options "nosniff"
Header set Referrer-Policy "strict-origin-when-cross-origin"
</IfModule>
